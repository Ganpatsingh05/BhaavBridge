<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BhaavBridge</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BhaavBridge.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success" asp-area="" asp-controller="Home" asp-action="Index">🌾 BhaavBridge</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Farmer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ProduceLot" asp-action="Index">My Lots</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Farmer">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Offer" asp-action="Incoming">Incoming Offers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Order" asp-action="FarmerOrders">My Orders</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="MarketReferencePrice" asp-action="Index">Market Prices</a>
                                </li>
                            }

                            @if (User.IsInRole("Buyer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Marketplace" asp-action="Index">Marketplace</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Buyer">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Offer" asp-action="MyOffers">My Offers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Order" asp-action="BuyerOrders">My Orders</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="MarketReferencePrice" asp-action="Index">Market Prices</a>
                                </li>
                            }

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Crop" asp-action="Index">Crops</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Dashboard" asp-action="Admin">Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Order" asp-action="All">All Orders</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="MarketReferencePrice" asp-action="Index">Market Prices</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-2">
                                @if (User.IsInRole("Farmer"))
                                {
                                    <span class="badge bg-success">🌾 Farmer: @User.Identity.Name</span>
                                }
                                else if (User.IsInRole("Buyer"))
                                {
                                    <span class="badge bg-primary">🛒 Buyer: @User.Identity.Name</span>
                                }
                                else if (User.IsInRole("Administrator"))
                                {
                                    <span class="badge bg-warning text-dark">⚙️ Admin: @User.Identity.Name</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@User.Identity.Name</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-success btn-sm ms-2" asp-controller="Account" asp-action="FarmerRegister">Farmer Register</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm ms-2" asp-controller="Account" asp-action="BuyerRegister">Buyer Register</a>
                            </li>
                        }
                    </ul>
              </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BhaavBridge — Know the offer. Compare the value. Make the right deal.
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
