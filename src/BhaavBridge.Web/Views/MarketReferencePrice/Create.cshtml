@model BhaavBridge.Web.Models.ViewModels.MarketReferencePriceFormViewModel
@{ ViewData["Title"] = "Add Market Reference Price"; }
<div class="container mt-4" style="max-width:850px">
<h2>Add Market Reference Price</h2><p class="text-muted">Enter a dated price and its source. Do not present an unverified value as a live mandi price.</p>
<form asp-action="Create" method="post" class="card card-body">@Html.AntiForgeryToken()<partial name="_Form" model="Model" /><div class="d-flex gap-2"><button class="btn btn-success">Save Reference Price</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
