@model IEnumerable<BhaavBridge.Web.Models.ViewModels.ProduceLotSummaryViewModel>
@{
    ViewData["Title"] = "My Harvest Lots";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🌾 My Harvest Lots</h2>
        <a asp-action="Create" class="btn btn-success">+ New Lot</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You haven't created any harvest lots yet.
            <a asp-action="Create">Create your first lot →</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-success">
                    <tr>
                        <th>Crop</th>
                        <th>Variety</th>
                        <th>Qty (qtl)</th>
                        <th>Asking Price (₹/qtl)</th>
                        <th>District, State</th>
                        <th>Harvest Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lot in Model)
                    {
                        <tr>
                            <td><strong>@lot.CropName</strong></td>
                            <td>@(lot.Variety ?? "—")</td>
                            <td>@lot.QuantityQuintals.ToString("N2")</td>
                            <td>₹@lot.AskingPricePerQuintal.ToString("N2")</td>
                            <td>@lot.District, @lot.State</td>
                            <td>@lot.HarvestDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @{
                                    var badgeClass = lot.Status switch
                                    {
                                        "Draft"     => "bg-secondary",
                                        "Published" => "bg-success",
                                        "Closed"    => "bg-dark",
                                        _           => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@lot.Status</span>
                            </td>
                            <td class="d-flex flex-wrap gap-1">
                                <a asp-action="Details" asp-route-id="@lot.ProduceLotId"
                                   class="btn btn-sm btn-outline-info">View</a>

                                @if (lot.Status == "Draft")
                                {
                                    <a asp-action="Edit" asp-route-id="@lot.ProduceLotId"
                                       class="btn btn-sm btn-outline-primary">Edit</a>

                                    <form asp-action="Publish" asp-route-id="@lot.ProduceLotId" method="post"
                                          onsubmit="return confirm('Publish this lot? Buyers will be able to see it.');">
                                        <button type="submit" class="btn btn-sm btn-success">Publish</button>
                                    </form>
                                }

                                @if (lot.Status != "Closed")
                                {
                                    <form asp-action="Close" asp-route-id="@lot.ProduceLotId" method="post"
                                          onsubmit="return confirm('Close this lot? It will no longer appear on the marketplace.');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Close</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
