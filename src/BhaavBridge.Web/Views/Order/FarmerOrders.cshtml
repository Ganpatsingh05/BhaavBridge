@model IEnumerable<BhaavBridge.Web.Models.ViewModels.OrderSummaryViewModel>
@{
    ViewData["Title"] = "Farmer Orders";
}
<div class="container mt-4">
    <h2>Orders for My Produce</h2>
    <p class="text-muted">Track buyer commitments and the agreed farmer net return.</p>
    @if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No accepted offers have created orders for your lots yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-light"><tr><th>Order</th><th>Crop</th><th>Buyer</th><th>Quantity</th><th>Price/qtl</th><th>Gross</th><th>Farmer costs</th><th>Net Daam</th><th>Status</th><th></th></tr></thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.OrderId</td>
                        <td>@order.CropName</td>
                        <td>@order.BuyerBusinessName</td>
                        <td>@order.QuantityQuintals.ToString("N2")</td>
                        <td>₹@order.AgreedPricePerQuintal.ToString("N2")</td>
                        <td>₹@order.GrossValue.ToString("N2")</td>
                        <td>₹@order.TotalFarmerCosts.ToString("N2")</td>
                        <td class="fw-semibold text-success">₹@order.EstimatedNetReturn.ToString("N2")</td>
                        <td><span class="badge bg-secondary">@order.Status</span></td>
                        <td><a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary">Details</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
