
@model CounterOfferViewModel

@{
    ViewData["Title"] = "Counter Offer";
}

<div class="container mt-4">
    <div class="card shadow-sm mx-auto" style="max-width: 650px;">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Submit Counter Offer</h4>
        </div>

        <div class="card-body">

            <p>
                <strong>Offer ID:</strong> #@ViewBag.OfferId
            </p>

            <p>
                <strong>Lot ID:</strong> #@ViewBag.LotId
            </p>

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <form asp-controller="Offer"
                  asp-action="Counter"
                  asp-route-id="@ViewBag.OfferId"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="PricePerQuintal"
                           class="form-label"></label>

                    <div class="input-group">
                        <span class="input-group-text">₹</span>

                        <input asp-for="PricePerQuintal"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0.01" />
                    </div>

                    <span asp-validation-for="PricePerQuintal"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Message"
                           class="form-label"></label>

                    <textarea asp-for="Message"
                              class="form-control"
                              rows="4"
                              placeholder="Explain your counteroffer to the buyer...">
                    </textarea>

                    <span asp-validation-for="Message"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Submit Counter Offer
                    </button>

                    <a asp-controller="Offer"
                       asp-action="Incoming"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
