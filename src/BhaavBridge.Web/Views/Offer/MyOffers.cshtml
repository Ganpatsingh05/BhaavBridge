
@model IEnumerable<BhaavBridge.Web.Models.ViewModels.BuyerOfferViewModel>

@{
    ViewData["Title"] = "My Offers";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Offers</h2>
            <p class="text-muted mb-0">
                Track your offers, farmer counteroffers and negotiated prices.
            </p>
        </div>

        <a asp-controller="Marketplace"
           asp-action="Index"
           class="btn btn-outline-primary">
            Browse Marketplace
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h5>No offers submitted yet</h5>
                <p class="text-muted">
                    Browse the marketplace and submit your first offer.
                </p>
                <a asp-controller="Marketplace"
                   asp-action="Index"
                   class="btn btn-primary">
                    Browse Marketplace
                </a>
            </div>
        </div>
    }
    else
    {
        @foreach (var offer in Model)
        {
            var statusClass = offer.Status switch
            {
                "Accepted" => "bg-success",
                "Rejected" => "bg-danger",
                "Countered" => "bg-warning text-dark",
                _ => "bg-secondary"
            };

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Offer #@offer.OfferId</strong>
                        <span class="text-muted ms-2">
                            Lot #@offer.ProduceLotId
                        </span>
                    </div>

                    <span class="badge @statusClass">
                        @offer.Status
                    </span>
                </div>

                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h5>@offer.CropName</h5>
                            <p class="mb-1">
                                <strong>Farmer:</strong> @offer.FarmerName
                            </p>
                            <p class="mb-1">
                                <strong>Quantity:</strong>
                                @offer.QuantityQuintals.ToString("N2") quintals
                            </p>
                            <p class="mb-1">
                                <strong>Submitted:</strong>
                                @offer.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </p>
                        </div>

                        <div class="col-md-6">
                            <p class="mb-1">
                                <strong>Original offer:</strong>
                                ₹@offer.OriginalPricePerQuintal.ToString("N2") / quintal
                            </p>
                            <p class="mb-1">
                                <strong>Current negotiated price:</strong>
                                ₹@offer.CurrentPricePerQuintal.ToString("N2") / quintal
                            </p>
                            <p class="mb-1">
                                <strong>Gross value:</strong>
                                ₹@offer.GrossValue.ToString("N2")
                            </p>
                            <p class="mb-1">
                                <strong>Estimated farmer costs:</strong>
                                ₹@offer.TotalEstimatedCosts.ToString("N2")
                            </p>
                            <p class="mb-1 text-success">
                                <strong>Estimated Net Daam:</strong>
                                ₹@offer.NetDaam.ToString("N2")
                            </p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(offer.Message))
                    {
                        <div class="alert alert-light border mt-3 mb-3">
                            <strong>Latest message:</strong>
                            @offer.Message
                        </div>
                    }

                    @if (offer.Revisions.Any())
                    {
                        <hr />

                        <h6 class="mb-3">Offer Negotiation History</h6>

                        <div class="table-responsive">
                            <table class="table table-sm table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Revision</th>
                                        <th>Proposed By</th>
                                        <th>Price / Quintal</th>
                                        <th>Quantity</th>
                                        <th>Costs</th>
                                        <th>Message</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var revision in offer.Revisions.OrderBy(r => r.RevisionNumber))
                                    {
                                        <tr>
                                            <td>@revision.RevisionNumber</td>
                                            <td>@revision.ProposedByName</td>
                                            <td>₹@revision.ProposedPricePerQuintal.ToString("N2")</td>
                                            <td>@revision.ProposedQuantityQuintals.ToString("N2")</td>
                                            <td>
                                                ₹@((revision.TransportationCost +
                                                    revision.LoadingCost +
                                                    revision.OtherFarmerCost).ToString("N2"))
                                            </td>
                                            <td>@(string.IsNullOrWhiteSpace(revision.Message) ? "—" : revision.Message)</td>
                                            <td>
                                                @revision.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (offer.Status == "Countered")
                    {
                        <div class="alert alert-warning mt-3 mb-3">
                            <strong>Farmer counteroffer received.</strong>
                            Review the latest negotiated price above.
                        </div>

                        <div class="d-flex gap-2">
                            <form asp-controller="Offer"
                                  asp-action="AcceptCounter"
                                  asp-route-id="@offer.OfferId"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Accept the farmer counteroffer and create an order?');">
                                    Accept Counteroffer
                                </button>
                            </form>

                            <form asp-controller="Offer"
                                  asp-action="RejectCounter"
                                  asp-route-id="@offer.OfferId"
                                  method="post">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-outline-danger"
                                        onclick="return confirm('Reject this farmer counteroffer?');">
                                    Reject Counteroffer
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
