
@model List<FarmerIncomingOfferViewModel>

@{
    ViewData["Title"] = "Incoming Offers";
}

<div class="container mt-4">
    <h2 class="mb-4">Incoming Offers</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not received any offers yet.
        </div>
    }
    else
    {
        @* Side-by-side comparison grouped by produce lot *@
       @if (!Model.Any(o => o.Status == "Pending" || o.Status == "Countered"))
{
    <div class="alert alert-info">
        There are no pending or countered offers available for comparison.
    </div>
}

@foreach (var lotGroup in Model
    .Where(o => o.Status == "Pending" || o.Status == "Countered")
    .GroupBy(o => o.ProduceLotId))
        {
            <div class="card mb-4 border-primary shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        Offer Comparison - @lotGroup.First().CropName
                        (Lot #@lotGroup.Key)
                    </h5>
                </div>

                <div class="card-body">
                    <p class="text-muted">
                        Compare buyers based on the estimated amount you receive
                        after deducting the listed farmer costs.
                    </p>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Buyer</th>
                                    <th>Price / Quintal</th>
                                    <th>Quantity</th>
                                    <th>Gross Value</th>
                                    <th>Total Costs</th>
                                    <th>Net Daam</th>
                                    <th>Net Daam / Quintal</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var offer in lotGroup.OrderByDescending(o => o.NetDaamPerQuintal))
                                {
                                    <tr>
                                        <td>
                                            <strong>@offer.BuyerBusinessName</strong>
                                            <br />
                                            <small class="text-muted">
                                                @offer.BuyerContactPerson
                                            </small>
                                        </td>

                                        <td>
                                            ₹@offer.OfferPricePerQuintal.ToString("N2")
                                        </td>

                                        <td>
                                            @offer.QuantityQuintals.ToString("N2") qtl
                                        </td>

                                        <td>
                                            ₹@offer.GrossValue.ToString("N2")
                                        </td>

                                        <td>
                                            ₹@offer.TotalEstimatedCosts.ToString("N2")
                                        </td>

                                        <td>
                                            <strong>
                                                ₹@offer.NetDaam.ToString("N2")
                                            </strong>
                                        </td>

                                        <td>
                                            <strong>
                                                ₹@offer.NetDaamPerQuintal.ToString("N2")
                                            </strong>
                                        </td>

                                        <td>
                                            @offer.Status
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <small class="text-muted">
                        Highest Net Daam per quintal is displayed first.
                        Only offers for this produce lot are compared.
                    </small>
                </div>
            </div>
        }

        @* Detailed offer cards with farmer actions *@
        @foreach (var offer in Model)
        {
            <div class="card mb-4 shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Offer #@offer.OfferId</strong>

                        <span class="text-muted ms-2">
                            Lot #@offer.ProduceLotId
                        </span>
                    </div>

                    <span class="badge bg-secondary">
                        @offer.Status
                    </span>
                </div>

                <div class="card-body">

                    <h5 class="card-title">@offer.CropName</h5>

                    <hr />

                    <h6>Buyer Details</h6>

                    <p class="mb-1">
                        <strong>Business Name:</strong>
                        @offer.BuyerBusinessName
                    </p>

                    <p class="mb-1">
                        <strong>Contact Person:</strong>
                        @offer.BuyerContactPerson
                    </p>

                    <p class="mb-3">
                        <strong>Buyer Name:</strong>
                        @offer.BuyerFullName
                    </p>

                    <hr />

                    <h6>Offer Details</h6>

                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <tbody>

                                <tr>
                                    <th>Quantity</th>
                                    <td>
                                        @offer.QuantityQuintals.ToString("N2") quintals
                                    </td>
                                </tr>

                                <tr>
                                    <th>Offered Price</th>
                                    <td>
                                        ₹@offer.OfferPricePerQuintal.ToString("N2") per quintal
                                    </td>
                                </tr>

                                <tr>
                                    <th>Gross Value</th>
                                    <td>
                                        ₹@offer.GrossValue.ToString("N2")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Transportation Cost</th>
                                    <td>
                                        ₹@offer.TransportationCost.ToString("N2")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Loading Cost</th>
                                    <td>
                                        ₹@offer.LoadingCost.ToString("N2")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Other Farmer Costs</th>
                                    <td>
                                        ₹@offer.OtherFarmerCost.ToString("N2")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Total Estimated Costs</th>
                                    <td>
                                        ₹@offer.TotalEstimatedCosts.ToString("N2")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Net Daam</th>
                                    <td>
                                        <strong>
                                            ₹@offer.NetDaam.ToString("N2")
                                        </strong>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Net Daam per Quintal</th>
                                    <td>
                                        <strong>
                                            ₹@offer.NetDaamPerQuintal.ToString("N2")
                                        </strong>
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(offer.Message))
                    {
                        <div class="mt-3">
                            <strong>Buyer's Message:</strong>
                            <p class="mb-0">@offer.Message</p>
                        </div>
                    }

                    <hr />

                    <small class="text-muted">
                        Received on:
                        @offer.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                    </small>

                    @if (offer.Status == "Pending")
                    {
                        <hr />

                        <div class="d-flex gap-2 flex-wrap">

                            @* Accept Offer *@
                            <form asp-controller="Offer"
                                  asp-action="Accept"
                                  asp-route-id="@offer.OfferId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-success"
                                        onclick="return confirm('Are you sure you want to accept this offer?');">
                                    Accept Offer
                                </button>
                            </form>

                            @* Reject Offer *@
                            <form asp-controller="Offer"
                                  asp-action="Reject"
                                  asp-route-id="@offer.OfferId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger"
                                        onclick="return confirm('Are you sure you want to reject this offer? This action cannot be undone.');">
                                    Reject Offer
                                </button>
                            </form>

                            @* Counter Offer *@
                            <a asp-controller="Offer"
                               asp-action="Counter"
                               asp-route-id="@offer.OfferId"
                               class="btn btn-primary">
                                Counter Offer
                            </a>

                        </div>
                    }
                    else if (offer.Status == "Countered")
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            Your counteroffer has been sent. The buyer must accept or reject it before another farmer action is available.
                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
