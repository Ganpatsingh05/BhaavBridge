    {
      "name": "Crops",
      "item": [
        {
          "name": "List active crops",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "{{authCookie}}"
              }
            ],
            "url": "{{baseUrl}}/api/crops",
            "description": "Farmer, Buyer or Administrator."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200 expected for List active crops\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response uses JSON where a body is present', function () {",
                  "  if (pm.response.text().length > 0) {",
                  "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create crop (Admin)",
